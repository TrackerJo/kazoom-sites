# Web3Forms access key — get one free at https://web3forms.com (tied to your inbox).
# Copy this file to .env.local and paste your key. .env.local is gitignored.
# This key is public-by-design (it ships in the client bundle); your destination
# email stays on the Web3Forms dashboard, never in the repo.
VITE_WEB3FORMS_KEY=<WEB3FORMS_ACCESS_KEY>
